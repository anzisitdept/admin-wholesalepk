rules_version = '2';

/**
 * CANONICAL Firestore rules for the `whole-sale-pk` project.
 *
 * This database is shared by two apps:
 *   - `wholesale-pk`      (storefront)  - public reads, server-side orders
 *   - `admin-wholesalepk` (admin panel) - everything else, straight from the browser
 *
 * Only ONE ruleset can be live per database, so this file is kept byte-for-byte
 * identical in both repos. If you edit it, copy the change to the other repo too.
 *
 * The admin panel is a client-side app with no server layer, so it depends on
 * these rules for ALL of its access. Anything tightened here must still let a
 * signed-in admin do their job - which is why management writes are gated on
 * the `role: "admin"` field rather than merely "is signed in".
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────

    // The caller's own users/{uid} document.
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The caller is flagged as an admin on their own profile document.
    function isAdminUid(uid) {
      return uid != null
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'admin';
    }

    function isAdmin() {
      return request.auth != null && isAdminUid(request.auth.uid);
    }

    // Fields that only the server (Admin SDK) or an admin may write. Without
    // this a customer could flip their own `blocked` flag, promote themselves
    // to admin, or rewrite the order counters the admin screen relies on.
    function protectedKeys() {
      return ['role', 'blocked', 'blockReason', 'blockedAt',
              'ip', 'deviceId', 'visitorId',
              'orderCount', 'totalSpent', 'orderIds', 'lastOrderAt'];
    }

    // On create there is no existing `resource`, so compare against the
    // incoming document directly.
    function createTouchesProtectedFields() {
      return request.resource.data.keys().hasAny(protectedKeys());
    }

    function updateTouchesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys());
    }

    // ─── Collections ──────────────────────────────────────────────────

    // 1. Products: public read for the storefront
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Categories: public read for the storefront
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Store content (homepage banners, top bar): public read
    match /store_content/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Store settings & general settings: public read
    match /store_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Coupons: public read
    match /coupons/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 6. Order counters. Sequential WSP-000001 numbering happens in
    //    POST /api/orders via the Admin SDK, so no browser needs this - and a
    //    public write would let anyone rewind it and cause duplicate numbers.
    match /counters/{document=**} {
      allow read, write: if isAdmin();
    }

    // 7. Orders. Written by POST /api/orders (Admin SDK, bypasses these rules),
    //    which records the real IP and refuses blocked visitors. The browser
    //    cannot create an order, so clearing cookies and calling Firestore
    //    directly does not bypass a block.
    //    The admin panel DOES write here - it updates order status from the
    //    browser - so writes are allowed for admins only. Reads are
    //    admin-only because orders hold names, emails, phones and addresses.
    match /orders/{document=**} {
      allow read, write: if isAdmin();
    }

    // 8. Customer reviews: public read and submit, admin moderates
    match /reviews/{document=**} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // 9. Users & tracked visitors. Every visitor to the site is recorded here
    //    by the server, so a browser session may only ever write its own
    //    harmless account fields. Admins can read every visitor in order to
    //    manage them from /admin/users.
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && !createTouchesProtectedFields();
      allow update: if isAdmin()
                    || (isSelf(userId) && !updateTouchesProtectedFields());
      allow delete: if isAdmin();
    }

    // 10. Default rule for any collection not listed above.
    //     This MUST be stricter than the explicit rules, not looser:
    //     Firestore ORs together every matching `allow`, so a permissive
    //     catch-all here would silently defeat the locked-down /users rule
    //     and let any signed-in customer read every visitor's IP and order
    //     history, or flip their own `blocked` / `role` fields.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
